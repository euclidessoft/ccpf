<!doctype html>
<html lang="fr">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>
        {% block title %} CAMEROON CONCRETES POLES FACTORY — CCPF {% endblock %}
    </title>
    <meta name="description" content="Des solutions robustes pour des infrastructures durables. Leader en fabrication de poteaux précontraints au Cameroun." />
    <meta name="keywords" content="Fabrication de Poteaux Précontraints, Production de Béton Prêt à l'Emploi, Construction & Travaux Publics, Infrastructures Durables, CCPF Cameroun" />
    <meta name="description" content="CCPF, Des solutions robustes pour des infrastructures durables">
    <meta name="author" content="Jambaar Corporation">
    <link href="{{ asset('images/favicon.ico') }}" rel="icon">
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">

    {% block style %}
    {% endblock %}
</head>
<body>
<!-- Navigation -->
<nav id="navbar">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between py-3 py-md-0" style="min-height:72px;">

            <!-- Logo -->
            <a href="#accueil" class="d-flex align-items-center gap-2 text-decoration-none" onclick="smoothScroll('#accueil')">
                <img src="https://hercules-cdn.com/file_m48wCIAl40FGkjH721lfuNxZ" alt="CCPF Logo"
                     style="height:40px;width:40px;border-radius:4px;object-fit:contain;background:#fff;padding:3px;" />
                <div>
                    <div class="navbar-brand-name">CCPF</div>
                    <div class="navbar-brand-sub d-none d-sm-block">Cameroon Concretes Poles Factory</div>
                </div>
            </a>

            <!-- Desktop nav -->
            <nav class="d-none d-md-flex align-items-center gap-1">
                <a href="#accueil" class="nav-link active" onclick="setActive(this,'#accueil')">Accueil</a>
                <a href="#services" class="nav-link" onclick="setActive(this,'#services')">Services</a>
                <a href="#apropos" class="nav-link" onclick="setActive(this,'#apropos')">À propos</a>
                <a href="#projets" class="nav-link" onclick="setActive(this,'#projets')">Projets</a>
                <a href="#contact" class="nav-link" onclick="setActive(this,'#contact')">Contact</a>
            </nav>

            <!-- CTA desktop + hamburger mobile -->
            <div class="d-flex align-items-center gap-2">
                <a href="tel:+237000000000" class="btn-call d-none d-md-inline-flex">
                    <i class="bi bi-telephone-fill"></i> Nous appeler
                </a>
                <button class="navbar-toggler d-md-none" id="menuBtn" onclick="toggleMenu()" aria-label="Menu">
                    <i class="bi bi-list" id="menuIcon"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobileMenu" class="d-none">
        <div class="container py-3">
            <a href="#accueil" class="nav-link d-block" onclick="mobileNav('#accueil')">Accueil</a>
            <a href="#services" class="nav-link d-block" onclick="mobileNav('#services')">Services</a>
            <a href="#apropos" class="nav-link d-block" onclick="mobileNav('#apropos')">À propos</a>
            <a href="#projets" class="nav-link d-block" onclick="mobileNav('#projets')">Projets</a>
            <a href="#contact" class="nav-link d-block" onclick="mobileNav('#contact')">Contact</a>
            <a href="tel:+237000000000" class="btn-call w-100 justify-content-center mt-2">
                <i class="bi bi-telephone-fill"></i> Nous appeler
            </a>
        </div>
    </div>
</nav>
{% block body %}
{% endblock %}
<!-- Footer -->
<footer>
    <div class="footer-main">
        <div class="container">
            <div class="row g-5">
                <!-- Brand -->
                <div class="col-md-6 col-lg-3">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <img src="https://hercules-cdn.com/file_m48wCIAl40FGkjH721lfuNxZ" alt="CCPF Logo"
                             style="height:44px;width:44px;border-radius:4px;object-fit:contain;background:#fff;padding:4px;" />
                        <div>
                            <div class="footer-brand-name">CCPF</div>
                            <div class="footer-brand-sub">Cameroon Concretes Poles Factory</div>
                        </div>
                    </div>
                    <p class="footer-slogan">"Des solutions robustes pour des infrastructures durables"</p>
                    <div class="d-flex gap-2">
                        <a href="#" class="footer-social"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="footer-social"><i class="bi bi-linkedin"></i></a>
                    </div>
                </div>

                <!-- Services -->
                <div class="col-md-6 col-lg-3">
                    <div class="footer-heading">Services</div>
                    <button class="footer-link" onclick="smoothScroll('#services')">Poteaux précontraints</button>
                    <button class="footer-link" onclick="smoothScroll('#services')">Béton prêt à l'emploi</button>
                    <button class="footer-link" onclick="smoothScroll('#services')">Construction &amp; Travaux publics</button>
                </div>

                <!-- Company -->
                <div class="col-md-6 col-lg-3">
                    <div class="footer-heading">Entreprise</div>
                    <button class="footer-link" onclick="smoothScroll('#apropos')">À propos de CCPF</button>
                    <button class="footer-link" onclick="smoothScroll('#apropos')">Notre équipe</button>
                    <button class="footer-link" onclick="smoothScroll('#apropos')">Certifications</button>
                    <button class="footer-link" onclick="smoothScroll('#contact')">Carrières</button>
                </div>

                <!-- Contact -->
                <div class="col-md-6 col-lg-3">
                    <div class="footer-heading">Contact</div>
                    <div class="footer-contact-item">
                        <i class="bi bi-geo-alt-fill"></i>
                        <span>Zone Industrielle de Bassa,<br>Douala, Cameroun</span>
                    </div>
                    <div class="footer-contact-item">
                        <i class="bi bi-telephone-fill"></i>
                        <a href="tel:+237000000000">+237 6XX XXX XXX</a>
                    </div>
                    <div class="footer-contact-item">
                        <i class="bi bi-envelope-fill"></i>
                        <a href="mailto:contact@ccpf-cameroun.com">contact@ccpf-cameroun.com</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="footer-bottom">
        <div class="container d-flex align-items-center justify-content-between flex-wrap gap-2">
            <p class="footer-copy mb-0" id="footerYear">
                © 2025 Cameroon Concretes Poles Factory (CCPF). Tous droits réservés.
            </p>
            <button class="btn-top" onclick="window.scrollTo({top:0,behavior:'smooth'})">
                <i class="bi bi-arrow-up"></i>
            </button>
        </div>
    </div>
</footer>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/js/all.min.js"></script>
<!-- Custom JS -->
<script src="{{ asset('js/scripts.js') }}"></script>
</body>
</html>