{% extends 'layout.html.twig' %}

{% block home %}active{% endblock %}

{% block body %}


    <!-- ================= HERO ================= -->
    <section class="hero-section" id="home">
        <div class="hero-slides">
            <div class="hero-slide slide_1 active">
            </div>
            <div class="hero-slide slide_2">
            </div>
            <div class="hero-slide slide_3">
            </div>
        </div>
        <div class="hero-overlay"></div>
        <div class="container hero-content">
            <div class="row align-items-center min-vh-100">
                <div class="col-lg-8 col-10 mt-5">
                    <h1 class="hero-title animate-fade-up" style="animation-delay:0.4s">
                        CAMEROON CONCRETES <br/>POLES
                        <span class="text-accent">FACTORY</span>
                        <span class="point"></span>
                    </h1>
                    <h2 class="hero-subtitle animate-fade-up" style="animation-delay:0.4s">
                        Des solutions robustes pour <br/>des infrastructures
                        <span class="text-accent">durables.</span>
                    </h2>
                    <p class="hero-text animate-fade-up mb-md-0" style="animation-delay:0.6s">
                        Spécialistes de la fabrication de poteaux précontraints, de la production de béton prêt à
                        l’emploi et des travaux de construction.
                    </p>
                    <p class="hero-text animate-fade-up d-none d-md-block" style="animation-delay:0.6s">
                        Nous accompagnons les projets publics et privés avec
                        des solutions robustes, durables et conformes aux exigences techniques les plus élevées.
                    </p>
                    <div class="hero-actions animate-fade-up d-flex flex-wrap gap-3" style="animation-delay:0.8s">
                        <a href="#services" class="btn btn-hero btn-accent btn-lg px-4">Nos services <i
                                    class="bi bi-arrow-right ms-1"></i></a>
                        <a href="#projects" class="btn btn-hero btn-outline-light btn-light btn-lg px-4">Voir nos
                            réalisations</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="hero-scroll-indicator">
            <div class="scroll-dot"></div>
        </div>
        <div class="hero-slide-controls" id="slideControls"></div>
    </section>

    <!-- ================= ABOUT ================= -->
    <section class="section-padding" id="about">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-6 h-100">
                    <div class="about-img-grid">
                        <img src="{{ asset('images/about.jpg') }}?auto=compress"
