                        <div class="col-sm-6 reveal" style="animation-delay:0.4s">
                            <div class="value-card"><i class="bi bi-award-fill value-icon"></i>
                                <div><h6>Qualité certifiée</h6>
                                    <p>Normes NF EN et ISO</p></div>
                            </div>
                        </div>
                        <div class="col-sm-6 reveal" style="animation-delay:0.5s">
                            <div class="value-card"><i class="bi bi-shield-check value-icon"></i>
                                <div><h6>Sécurité maximale</h6>
                                    <p>Conformité réglementaire</p></div>
                            </div>
                        </div>
                        <div class="col-sm-6 reveal" style="animation-delay:0.6s">
                            <div class="value-card"><i class="bi bi-recycle value-icon"></i>
                                <div><h6>Éco-responsable</h6>
                                    <p>Processus durables</p></div>
                            </div>
                        </div>
                        <div class="col-sm-6 reveal" style="animation-delay:0.7s">
                            <div class="value-card"><i class="bi bi-people-fill value-icon"></i>
                                <div><h6>Équipe experte</h6>
                                    <p>Ingénieurs & techniciens</p></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
