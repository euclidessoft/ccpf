                    <div class="service-icon-badge">
                        <i class="fa-solid fa-building fs-5"></i>
                    </div>
                </div>
                <div class="service-body">
                    <div class="service-num text-accent">Service 03</div>
                    <h3 class="service-title">Construction & Travaux Publics</h3>
                    <p class="service-desc">
