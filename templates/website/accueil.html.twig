                <div class="section-tag">Parlons de votre projet</div>
                <h2 class="section-title">Contactez-nous</h2>
                <p class="text-muted mx-auto" style="max-width:440px;font-size:.93rem;">
                    Un projet, un devis, une question ? Notre équipe est à votre écoute.
                </p>
            </div>
            <div class="row g-5">
                <!-- Info -->
                <div class="col-lg-5">
                    <div class="d-flex gap-3 mb-4">
                        <div class="contact-info-icon"><i class="bi bi-geo-alt-fill"></i></div>
                        <div>
                            <div class="contact-info-label">Adresse</div>
                            <div class="contact-info-value">Zone Industrielle de Bassa<br>Douala, Cameroun</div>
                        </div>
                    </div>
                    <div class="d-flex gap-3 mb-4">
                        <div class="contact-info-icon"><i class="bi bi-telephone-fill"></i></div>
                        <div>
                            <div class="contact-info-label">Téléphone</div>
                            <div class="contact-info-value">+237 6XX XXX XXX<br>+237 2XX XXX XXX</div>
                        </div>
                    </div>
                    <div class="d-flex gap-3 mb-4">
                        <div class="contact-info-icon"><i class="bi bi-envelope-fill"></i></div>
                        <div>
                            <div class="contact-info-label">Email</div>
                            <div class="contact-info-value">contact@ccpf-cameroun.com<br>devis@ccpf-cameroun.com</div>
                        </div>
                    </div>
                    <div class="d-flex gap-3 mb-4">
                        <div class="contact-info-icon"><i class="bi bi-clock-fill"></i></div>
                        <div>
                            <div class="contact-info-label">Horaires</div>
                            <div class="contact-info-value">Lun–Ven : 07h30 – 17h30<br>Sam : 08h00 – 13h00</div>
                        </div>
                    </div>
                    <div class="contact-map">
                        <img src="https://images.unsplash.com/photo-1682924754765-75832404fd1d?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=600&q=80" alt="Localisation" />
                        <div class="contact-map-pin">
                            <div class="contact-map-pill"><i class="bi bi-geo-alt-fill"></i> Douala, Cameroun</div>
                        </div>
                    </div>
                </div>
                <!-- Form -->
                <div class="col-lg-7">
                    <div id="formWrap">
                        <form class="contact-form" onsubmit="submitForm(event)">
                            <div class="row g-4 mb-4">
                                <div class="col-sm-6">
                                    <label class="form-label-custom">Nom complet <span class="required-star">*</span></label>
                                    <input type="text" id="nom" class="form-control-custom" placeholder="Jean Dupont" required />
                                </div>
                                <div class="col-sm-6">
                                    <label class="form-label-custom">Email <span class="required-star">*</span></label>
                                    <input type="email" id="email" class="form-control-custom" placeholder="email@example.com" required />
                                </div>
                                <div class="col-sm-6">
                                    <label class="form-label-custom">Téléphone</label>
                                    <input type="tel" id="tel" class="form-control-custom" placeholder="+237 6XX XXX XXX" />
                                </div>
                                <div class="col-sm-6">
                                    <label class="form-label-custom">Service concerné</label>
                                    <select id="service" class="form-control-custom">
                                        <option value="">Choisir un service</option>
                                        <option value="poteaux">Poteaux précontraints</option>
                                        <option value="beton">Béton prêt à l'emploi</option>
                                        <option value="travaux">Construction &amp; Travaux</option>
                                        <option value="autre">Autre</option>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label-custom">Message <span class="required-star">*</span></label>
                                    <textarea id="message" class="form-control-custom" rows="5" placeholder="Décrivez votre projet ou votre demande..." required style="resize:none;"></textarea>
                                </div>
                            </div>
                            <button type="submit" class="btn-submit">
                                <i class="bi bi-send-fill"></i> Envoyer le message
                            </button>
                        </form>
                    </div>
                    <div id="successBox" class="success-box d-none">
                        <div class="success-icon"><i class="bi bi-check-circle-fill"></i></div>
                        <div class="success-title">Message envoyé !</div>
                        <p class="success-msg">Merci pour votre message. Notre équipe vous contactera dans les 24 heures ouvrables.</p>
                        <button class="btn-reset" onclick="resetForm()">Envoyer un autre message</button>
                    </div>
                </div>
            </div>
        </div>
    </section>

{% endblock %}