{% extends 'layout.html.twig' %}

{% block home %}active{% endblock %}

{% block body %}


    <!-- ════════════════════════ HERO ════════════════════════ -->
    <section id="accueil">
        <div class="hero-bg">
            <img src="https://images.unsplash.com/photo-1592766491773-56e75cfb5c5e?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=1920&q=80" alt="Infrastructure béton" />
            <div class="hero-overlay"></div>
            <div class="hero-overlay-bottom"></div>
            <div class="hero-pattern"></div>
            <div class="hero-accent-bar"></div>
        </div>
        <div class="container hero-content">
            <div style="max-width:700px;">
                <div class="hero-badge">
                    <span class="dot"></span>
                    Industrie du Béton — Cameroun
                </div>
                <h1 class="hero-title">
                    CAMEROON<br>
                    <span>CONCRETES</span><br>
                    POLES FACTORY
                </h1>
                <p class="hero-slogan">"Des solutions robustes pour des infrastructures durables"</p>
                <p class="hero-desc">
                    Leader dans la fabrication de poteaux précontraints et la production de béton prêt à l'emploi,
                    CCPF construit les infrastructures de demain au Cameroun et en Afrique centrale.
                </p>
                <div class="d-flex flex-column flex-sm-row gap-3">
                    <a href="#services" class="btn-hero-primary" onclick="smoothScroll('#services',event)">
                        Nos services <i class="bi bi-arrow-right"></i>
                    </a>
                    <a href="#contact" class="btn-hero-secondary" onclick="smoothScroll('#contact',event)">
                        Nous contacter
                    </a>
                </div>
            </div>
        </div>
        <button class="scroll-indicator" onclick="smoothScroll('#services')">
            <span>Découvrir</span>
            <i class="bi bi-chevron-down"></i>
        </button>
    </section>

    <!-- ════════════════════════ STATS ════════════════════════ -->
    <section id="stats">
        <div class="container">
            <div class="stats-grid">
                <div class="stat-item">
                    <div class="stat-number" data-target="15" data-suffix="+">0+</div>
                    <div class="stat-label">Années d'expérience</div>
                    <div class="stat-desc">Dans l'industrie du béton</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number" data-target="5000" data-suffix="+">0+</div>
                    <div class="stat-label">Poteaux produits</div>
                    <div class="stat-desc">Par an</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number" data-target="200" data-suffix="+">0+</div>
                    <div class="stat-label">Projets réalisés</div>
                    <div class="stat-desc">À travers le Cameroun</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number" data-target="98" data-suffix="%">0%</div>
                    <div class="stat-label">Satisfaction client</div>
                    <div class="stat-desc">Attestée par nos partenaires</div>
                </div>
            </div>
        </div>
    </section>

    <!-- ════════════════════════ SERVICES ════════════════════════ -->
    <section id="services">
        <div class="container">
            <div class="text-center mb-5">
                <div class="section-tag">Ce que nous faisons</div>
                <h2 class="section-title">Nos Services</h2>
                <p class="text-muted mx-auto" style="max-width:540px;font-size:.95rem;">
                    Experts en béton précontraint et en travaux de génie civil, nous offrons des solutions intégrées pour toutes vos infrastructures.
                </p>
            </div>

            <!-- Service 1 -->
            <div class="service-card">
                <div class="service-img-wrap">
                    <img src="https://images.unsplash.com/photo-1675176785665-8d6aef6b7d8a?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=800&q=80" alt="Poteaux précontraints" />
                    <div class="service-img-overlay"></div>
                    <div class="service-icon-badge" style="background:#0E4B7A;">
                        <i class="bi bi-lightning-charge-fill text-white fs-5"></i>
                    </div>
                </div>
                <div class="service-body">
                    <div class="service-num" style="color:#0E4B7A;">Service 01</div>
                    <h3 class="service-title">Fabrication de Poteaux Précontraints</h3>
                    <p class="service-desc">Nos poteaux précontraints sont fabriqués selon les normes les plus strictes, garantissant une résistance optimale pour vos lignes électriques, téléphoniques et structures de soutien.</p>
                    <ul class="service-features">
                        <li style="--dot-color:#0E4B7A;"><span style="width:6px;height:6px;border-radius:50%;background:#0E4B7A;display:inline-block;flex-shrink:0;"></span>Poteaux basse et moyenne tension</li>
                        <li><span style="width:6px;height:6px;border-radius:50%;background:#0E4B7A;display:inline-block;flex-shrink:0;"></span>Poteaux de télécommunication</li>
                        <li><span style="width:6px;height:6px;border-radius:50%;background:#0E4B7A;display:inline-block;flex-shrink:0;"></span>Poteaux d'éclairage public</li>
                        <li><span style="width:6px;height:6px;border-radius:50%;background:#0E4B7A;display:inline-block;flex-shrink:0;"></span>Contrôle qualité rigoureux</li>
                    </ul>
                    <a href="#contact" class="btn-devis" style="color:#0E4B7A;" onclick="smoothScroll('#contact',event)">
                        Demander un devis <span>&#8594;</span>
                    </a>
                </div>
            </div>

            <!-- Service 2 -->
            <div class="service-card reverse">
                <div class="service-img-wrap">
                    <img src="https://images.unsplash.com/photo-1524177536702-14df4a2a0a71?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=800&q=80" alt="Béton prêt à l'emploi" />
                    <div class="service-img-overlay"></div>
                    <div class="service-icon-badge" style="background:#6C757D;">
                        <i class="bi bi-truck text-white fs-5"></i>
                    </div>
                </div>
                <div class="service-body">
                    <div class="service-num" style="color:#6C757D;">Service 02</div>
                    <h3 class="service-title">Production de Béton Prêt à l'Emploi</h3>
                    <p class="service-desc">CCPF produit un béton de haute qualité, formulé précisément pour chaque application. Livraison directe sur chantier avec des toupies modernes.</p>
                    <ul class="service-features">
                        <li><span style="width:6px;height:6px;border-radius:50%;background:#6C757D;display:inline-block;flex-shrink:0;"></span>Béton dosé et contrôlé</li>
                        <li><span style="width:6px;height:6px;border-radius:50%;background:#6C757D;display:inline-block;flex-shrink:0;"></span>Livraison rapide sur site</li>
                        <li><span style="width:6px;height:6px;border-radius:50%;background:#6C757D;display:inline-block;flex-shrink:0;"></span>Différentes résistances disponibles</li>
                        <li><span style="width:6px;height:6px;border-radius:50%;background:#6C757D;display:inline-block;flex-shrink:0;"></span>Formules adaptées aux projets</li>
                    </ul>
                    <a href="#contact" class="btn-devis" style="color:#6C757D;" onclick="smoothScroll('#contact',event)">
                        Demander un devis <span>&#8594;</span>
                    </a>
                </div>
            </div>

            <!-- Service 3 -->
            <div class="service-card">
                <div class="service-img-wrap">
                    <img src="https://images.unsplash.com/photo-1647735282077-c12699af40be?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=800&q=80" alt="Construction & Travaux publics" />
                    <div class="service-img-overlay"></div>
                    <div class="service-icon-badge" style="background:#F58220;">
                        <i class="bi bi-hard-drive text-white fs-5"></i>
                    </div>
                </div>
                <div class="service-body">
                    <div class="service-num" style="color:#F58220;">Service 03</div>
                    <h3 class="service-title">Construction &amp; Travaux Publics</h3>
                    <p class="service-desc">De la conception à la réalisation, nos équipes expérimentées prennent en charge vos projets de construction et de travaux publics avec professionnalisme.</p>
                    <ul class="service-features">
                        <li><span style="width:6px;height:6px;border-radius:50%;background:#F58220;display:inline-block;flex-shrink:0;"></span>Routes et voiries</li>
                        <li><span style="width:6px;height:6px;border-radius:50%;background:#F58220;display:inline-block;flex-shrink:0;"></span>Ouvrages d'art</li>
                        <li><span style="width:6px;height:6px;border-radius:50%;background:#F58220;display:inline-block;flex-shrink:0;"></span>Réseaux d'assainissement</li>
                        <li><span style="width:6px;height:6px;border-radius:50%;background:#F58220;display:inline-block;flex-shrink:0;"></span>Génie civil et bâtiment</li>
                    </ul>
                    <a href="#contact" class="btn-devis" style="color:#F58220;" onclick="smoothScroll('#contact',event)">
                        Demander un devis <span>&#8594;</span>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- ════════════════════════ ABOUT ════════════════════════ -->
